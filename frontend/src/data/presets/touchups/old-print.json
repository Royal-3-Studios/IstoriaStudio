{
  "id": "vintage_old_print",
  "name": "Old Print (Desat)",
  "subtitle": "Slight bleed on paper grain; paint to desaturate",
  "baseSizePx": 14,
  "color": "#7f7f7f",

  "engine": {
    "version": 1,
    "backend": "ribbon",
    "shape": { "type": "round", "softness": 75, "sizeScale": 1 },
    "strokePath": {
      "spacing": 6,
      "jitter": 0.15,
      "scatter": 0.4,
      "count": 1,
      "streamline": 25
    },
    "grain": {
      "kind": "paper",
      "depth": 0.35,
      "scale": 1.1,
      "rotate": 0,
      "motion": "paperLocked"
    },
    "rendering": {
      "intent": "ink",
      "flow": 45,
      "blendMode": "saturation"
    },
    "overrides": {
      "opacity": 100,
      "sizeJitter": 0.12,
      "angleJitter": 4,
      "grainDepth": 0.35,
      "grainScale": 1.1,
      "grainRotate": 0,
      "microJitterPx": 0.25,
      "microJitterFreq": 0.8,
      "glazeBlurPx": 0.4,
      "bgIsLight": true
    },
    "backendOverrides": {
      "ribbon": {
        "mode": "ink",
        "grainDepth": 0.35,
        "grainScale": 1.1,
        "glazeBlurPx": 0.4,
        "microJitterPx": 0.25,
        "microJitterFreq": 0.8
      }
    }
  },

  "input": {
    "pressure": {
      "clamp": { "min": 0, "max": 1 },
      "curve": { "type": "gamma", "gamma": 0.9 },
      "smoothing": {
        "mode": "oneEuro",
        "oneEuro": { "minCutoff": 1.3, "beta": 0.25, "dCutoff": 1.2 }
      },
      "gain": 1.0,
      "deadZone": 0.02
    },
    "quality": {
      "predictPx": 2,
      "speedToSpacing": 0.06,
      "minStepPx": 0.7
    }
  },

  "tags": ["Vintage", "Paper Grain", "Desaturate", "Saturation Blend"]
}
