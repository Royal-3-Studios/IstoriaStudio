{
  "id": "touchups_highlights",
  "name": "Highlights",
  "subtitle": "Soft screen/add touch-ups",
  "baseSizePx": 8,
  "color": "#FFFFFF",

  "engine": {
    "version": 1,
    "backend": "spray",
    "shape": { "type": "round", "softness": 92, "sizeScale": 1 },
    "strokePath": {
      "spacing": 6,
      "jitter": 0.3,
      "scatter": 0.5,
      "count": 1,
      "streamline": 20
    },
    "grain": { "kind": "none" },
    "rendering": {
      "intent": "ink",
      "flow": 28,
      "blendMode": "screen"
    },
    "overrides": {
      "opacity": 100,
      "tiltToSize": 0.25
    },
    "backendOverrides": {
      "spray": {
        "mode": "airbrush",
        "dropletCount": 12,
        "dropletJitter": 0.15,
        "dropletSizeMin": 0.2,
        "dropletSizeMax": 2
      }
    }
  },

  "input": {
    "pressure": {
      "clamp": { "min": 0, "max": 1 },
      "curve": { "type": "gamma", "gamma": 0.9 },
      "smoothing": {
        "mode": "oneEuro",
        "oneEuro": { "minCutoff": 1.2, "beta": 0.2, "dCutoff": 1.0 }
      },
      "gain": 1,
      "deadZone": 0.02
    },
    "quality": {
      "predictPx": 4,
      "speedToSpacing": 0.15,
      "minStepPx": 0.7
    }
  },

  "tags": ["Touch-ups", "Highlights", "Screen", "Additive", "Soft"]
}
