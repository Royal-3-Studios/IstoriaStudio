{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "lib": [
            "ES2022",
            "WebWorker"
        ],
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.worker.ts",
        "src/**/worker/**"
    ]
}